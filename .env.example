# ---------------------------------------------------------------------------
# Required — Totalum (operator key; never expose to the browser)
# ---------------------------------------------------------------------------
# Register at https://www.totalum.app/api and choose "Use the Totalum API".
# API reference: https://www.totalum.app/totalum-api.md
TOTALUM_VCAAS_API_KEY=

# ---------------------------------------------------------------------------
# Required — Supabase (customer auth + wallets)
# ---------------------------------------------------------------------------
# Create a project at https://supabase.com — do not paste secret keys into chat.
# Put these in Vercel / .env.local only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that receive the admin dashboard (matched on sign-in).
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Required for paid plans — Stripe (RyanFenn.ai billing, not Totalum)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs are also stored in the admin UI (plans.stripe_price_id / credit_packs).
# Create products: Builder $29/mo, Pro $99/mo, plus one-time credit packs.

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Set true during the credit redenomination window. Blocks new spend, Checkout,
# and Stripe webhook processing (webhooks get 503 and Stripe retries).
# BILLING_MAINTENANCE=true

# Public origin. Used by Checkout return URLs and src/proxy.ts CORS in production.
# NEXT_PUBLIC_APP_URL=https://ryanfenn.ai

# Totalum API host. Defaults to https://builder-api.totalum.app
# TOTALUM_API_URL=https://builder-api.totalum.app
